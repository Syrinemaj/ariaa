APP_NAME=ARIA

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://aria:${POSTGRES_PASSWORD}@postgres:5432/aria

POSTGRES_USER=aria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aria

# ── Redis ─────────────────────────────────────────────────────────────────────
# Legacy single-URL (still required for backward compat).
# The three scoped URLs below are DERIVED from this if not set explicitly.
#
# Why three separate Redis DB indices?
#   /0 broker  — Celery task queue messages (high write, short TTL)
#   /1 backend — Celery task results (TTL = 1 hour, then auto-deleted)
#   /2 app     — Rate limiting, job progress, JTI blocklist, sessions
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_BACKEND_URL=redis://redis:6379/1
REDIS_APP_URL=redis://redis:6379/2

# ── AI provider ───────────────────────────────────────────────────────────────
# "groq"  (default) — Groq LLM for all completions + local embeddings (BAAI/bge-small-en)
# "azure"           — Azure OpenAI for completions (legacy; embeddings still use local model)
AI_PROVIDER=groq

# ── Groq (primary completion provider) ───────────────────────────────────────
# Get your key at: console.groq.com
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Local embeddings (sentence-transformers) ──────────────────────────────────
# Model is downloaded from HuggingFace Hub on first use (~33 MB).
# Set to a local path to use a pre-downloaded model (air-gapped environments).
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en

# ── Azure OpenAI (optional — fallback for completions only) ───────────────────
# Required only if: AI_PROVIDER=azure  OR  you want Groq→Azure fallback on errors.
# Embeddings are always handled by the local model, regardless of this setting.
# AZURE_OPENAI_ENDPOINT=https://YOUR-ENDPOINT.openai.azure.com/
# AZURE_OPENAI_API_KEY=YOUR_KEY
# AZURE_OPENAI_MODEL=gpt-4o-mini
# AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # unused — kept for compat
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── Authentication ────────────────────────────────────────────────────────────
# Minimum 32 bytes. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-minimum-32-byte-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Multi-tenancy ─────────────────────────────────────────────────────────────
DEFAULT_ORG_NAME=ARIA Demo Organization

# ── File uploads ──────────────────────────────────────────────────────────────
HAR_MAX_SIZE_MB=50
BULK_FILE_MAX_SIZE_MB=20
BULK_MAX_ROWS=10000
# Rows per Celery batch task (50 = ~25s per task at 500ms/step/row)
BULK_BATCH_SIZE=50

# ── SSRF protection ───────────────────────────────────────────────────────────
# Comma-separated list of allowed HTTPS target domains.
# Leave empty to allow any domain (development only — unsafe for production).
ALLOWED_TARGET_DOMAINS=https://hr-api.company.com,https://sandbox-api.company.com

# ── Rate limiting (Redis-backed, distributed across all workers) ──────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute        # login endpoint (anti brute-force)
RATE_LIMIT_UPLOAD=10/hour       # HAR analyze (LLM pipeline, expensive)
RATE_LIMIT_EXECUTE=5/minute     # bulk execute (enqueue protection)

# ── LLM cost tracking ─────────────────────────────────────────────────────────
LLM_PROMPT_COST_PER_1K=0.00015
LLM_COMPLETION_COST_PER_1K=0.00060
LLM_HIGH_TOKEN_THRESHOLD=5000
LLM_MAX_COMPLETION_TOKENS=1000
# Token-based limit (replaces old LLM_MAX_INPUT_CHARS heuristic)
LLM_MAX_INPUT_TOKENS=120000
LLM_MAX_INPUT_CHARS=32000       # kept for backward compat

# ── File cleanup ──────────────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
UPLOAD_FILE_TTL_DAYS=7
UPLOAD_FAILED_FILE_TTL_HOURS=24
CLEANUP_DRY_RUN=false

# ── /metrics protection ───────────────────────────────────────────────────────
# Comma-separated IPs allowed to access /metrics (Prometheus scraper, etc.)
METRICS_ALLOWED_IPS=127.0.0.1,10.0.0.5
# Bearer token used BOTH by the API guard AND by Prometheus in prometheus.yml.
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
METRICS_BEARER_TOKEN=aria-metrics-secret

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=aria-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_METRICS_ENABLED=true

# ── Embedding cache ───────────────────────────────────────────────────────────
# SHA-256 content-addressed Redis TTL (seconds). Default: 86400 (24h).
# EMBEDDING_CACHE_REDIS_TTL=86400

# ── Schema drift ──────────────────────────────────────────────────────────────
# SCHEMA_DRIFT_BLOCK_ON_BREAKING=true
