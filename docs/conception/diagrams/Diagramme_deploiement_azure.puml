@startuml Diagramme_deploiement_azure
!theme plain

title Architecture de déploiement — Azure Container Apps (infrastructure/github_actions/deploy.yml, infrastructure/azure/deploy_azure_cli.md)

node "Poste de développement" as Dev {
  [Code source ARIA]
}

node "GitHub" as GH {
  [Dépôt Git]
  [GitHub Actions\n(.github/workflows/ci.yml,\ninfrastructure/github_actions/deploy.yml)] as CI
}

node "Azure Container Registry (ACR)" as ACR {
  [aria-api:<sha>/latest]
  [aria-worker:<sha>/latest]
}

node "Resource Group: aria-rg\n(région: francecentral)" as RG {
  node "Container Apps Environment: aria-env" as Env {
    node "Container App: aria-api\n(min 1 / max 3 réplicas,\nport 8000, ingress externe)" as AriaApi {
      [Image aria-api]
    }
    node "Container App: aria-worker\n(min 1 / max 2 réplicas,\npas d'ingress)" as AriaWorker {
      [Image aria-worker]
    }
  }
  node "PostgreSQL + pgvector" as AzurePG
  node "Redis" as AzureRedis
}

Dev --> GH : git push (branche main)
GH --> CI : déclenchement sur push
CI --> ACR : docker build + push\n(api.prod.Dockerfile, worker.prod.Dockerfile)
CI --> AriaApi : az containerapp update --image ...
CI --> AriaWorker : az containerapp update --image ...
ACR --> AriaApi : pull image
ACR --> AriaWorker : pull image
AriaApi --> AzurePG : DATABASE_URL (secretref)
AriaWorker --> AzurePG : DATABASE_URL (secretref)
AriaApi --> AzureRedis : REDIS_URL (secretref)
AriaWorker --> AzureRedis : REDIS_URL (secretref)
CI --> AriaApi : health check\nGET /health (post-déploiement)

note bottom of AzurePG
  % [INVENTÉ-5] Hébergement exact de PostgreSQL/Redis
  en production (service managé Azure Database for
  PostgreSQL / Azure Cache for Redis, ou conteneurs
  additionnels) non explicité dans deploy_azure_cli.md
  — seules les variables DATABASE_URL/REDIS_URL
  (secretref) sont confirmées dans le code.
end note

@enduml
