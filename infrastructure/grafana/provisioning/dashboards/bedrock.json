{
  "title": "ARIA — Amazon Bedrock",
  "uid": "aria-bedrock",
  "description": "Tokens et coûts pour le provider Bedrock (AI_PROVIDER=bedrock, actif par défaut — modèle courant : deepseek.v3.2, voir app/core/config.py::BEDROCK_MODEL). Fonctionne avec n'importe quel modèle Bedrock configuré, pas seulement Claude — les panels 'par modèle' se réajustent automatiquement si BEDROCK_MODEL change.",
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "aria",
    "bedrock",
    "deepseek",
    "llm"
  ],
  "schemaVersion": 38,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "📊 Résumé Bedrock",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "title": "Tokens totaux (24h)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50000
              },
              {
                "color": "red",
                "value": 500000
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(aria_llm_tokens_total{provider=\"bedrock\"}[24h]))",
          "legendFormat": "Tokens"
        }
      ]
    },
    {
      "id": 2,
      "title": "Coût estimé (24h)",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(aria_llm_cost_total{provider=\"bedrock\"}[24h]))",
          "legendFormat": "Coût USD"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tokens/min (actuel)",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
